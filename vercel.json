{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "functions": {
    "app/**/*": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/answers", "schedule": "5 2,3,6,14,22,23 * * *" },
    { "path": "/api/revalidate", "schedule": "1 0 * * *" }
  ]
}
