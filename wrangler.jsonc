{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funzzle",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // OpenNext calls back into this Worker (ISR regeneration via the DO queue).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "funzzle" }],
  "observability": { "enabled": true },
  // Only funzzle.com / www serve the site: no *.workers.dev or preview URLs,
  // which would be duplicates of it. (workers.dev was the pre-cutover
  // verification host.)
  "workers_dev": false,
  "preview_urls": false,
  // www and apex are Worker routes over the zone's existing DNS records, not
  // custom domains: Cloudflare won't attach a custom domain to a hostname that
  // already has records, and deleting them first would mean downtime. Routes
  // only apply to PROXIED records, so these take over the instant the apex
  // and www records are switched from DNS-only to Proxied — and switching
  // them back is the rollback to Vercel.
  "routes": [
    { "pattern": "www.funzzle.com/*", "zone_name": "funzzle.com" },
    { "pattern": "funzzle.com/*", "zone_name": "funzzle.com" }
  ],
  // Cron Triggers replace Vercel Cron; worker.ts maps each schedule to its route.
  // Every scheduled job lives here (docs/cloudflare-stack.md has the layout):
  //   00:01           rollover: revalidate today's pages
  //   02:05 … 23:05   answers: fetch missing NYT answers + store daily puzzles
  //   03:20 … 23:20   explain: DeepSeek answer explanations + Sudoku coach text
  //   13:00           reminders: daily email + web push (9 a.m. Eastern in summer)
  "triggers": {
    "crons": ["1 0 * * *", "5 2,3,6,14,22,23 * * *", "20 3,7,15,23 * * *", "0 13 * * *"]
  },
  // CPU cap per invocation (requests and crons alike): 60 s covers the coach
  // cron's Sudoku solver walk and archive Solitaire deals with room to spare,
  // while a runaway request still stops long before the 5-minute maximum.
  "limits": { "cpu_ms": 60000 },
  // Secrets (wrangler secret put): CRON_SECRET, REVALIDATE_SECRET, DEEPSEEK_API_KEY,
  // ALERT_EMAIL_FALLBACK, VAPID_PRIVATE_JWK (web push; the public key is
  // NEXT_PUBLIC_VAPID_PUBLIC_KEY in .env.production).
  // NEXT_PUBLIC_* values are inlined by `next build` (from .env.production and
  // the build environment), not read from here.
  "vars": {
    "ALERT_EMAIL_TO": "hello@funzzle.com",
    "ALERT_EMAIL_FROM": "alerts@funzzle.com"
  },
  // Failure alerts from cron jobs (worker.ts), sent through Email Routing.
  "send_email": [
    { "name": "ALERT_EMAIL" },
    // Daily reminder emails (Email Sending, funzzle.com onboarded): any recipient,
    // only from this sender.
    { "name": "MAILER", "allowed_sender_addresses": ["puzzles@funzzle.com"] }
  ],
  // Gameplay analytics events (app/api/events): Analytics Engine, not D1, so
  // they never touch the D1 write quota.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "funzzle_events" }],
  // ISR cache for OpenNext: pages in R2 (fronted by the per-colo regional
  // cache), the D1 tag cache that revalidatePath() needs, and the Durable
  // Object queue for time-based regeneration.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "funzzle-opennext-cache" }],
  "d1_databases": [
    // App data (migrations/). "remote" makes `next build` and local dev read the
    // production database through Wrangler, as builds once read Supabase.
    {
      "binding": "DB",
      "database_name": "funzzle-db",
      "database_id": "550335eb-16b4-4fcd-a469-6e3f3a79a78a",
      "migrations_dir": "migrations",
      "remote": true
    },
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "funzzle-tags", "database_id": "e283a45f-9de6-474f-a58f-3da9778e1440" }
  ],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
