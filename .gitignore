# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Public build-time values only (inlined into pages anyway); never secrets.
!.env.production

# local NYT auth capture (Copy-as-cURL) — never commit
.nyt_curl.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated keyword research outputs
scripts/keyword-opportunities.json
scripts/trending-opportunities.json

# cloudflare / opennext
.open-next
.wrangler
.dev.vars*

# Playwright
/test-results/
/playwright-report/

# Supabase CLI state
/supabase/.temp/
.claude/worktrees/

# raw word-list downloads (scripts/build-wordlists.mjs)
scripts/.wordlists-cache/

# raw country boundaries (scripts/gen-geo-shapes.mjs)
scripts/.geo-cache/

# Local data backups (never commit)
/backups/
